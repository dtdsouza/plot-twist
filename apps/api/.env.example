# Core
NODE_ENV=development
PORT=3333

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=plot-twist
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Identity
JWT_SECRET=change-me-to-a-secure-secret-in-production
JWT_EXPIRES_IN=7d

# Mail
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
PASSWORD_RESET_URL=http://localhost:3000/reset-password
EMAIL_CHANGE_VERIFICATION_URL=http://localhost:4200/verify-email-change

# Storage / S3
# For local dev, point at LocalStack on host port 4566 and use dummy credentials.
# In production, leave S3_ENDPOINT empty and provide real AWS credentials (or use IAM roles).
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_AVATARS=plot-twist-avatars
# Optional: CDN base URL; when set, replaces the S3/endpoint URL builder.
S3_PUBLIC_URL_BASE=
MAX_AVATAR_SIZE_BYTES=2097152
MAX_AVATAR_DIMENSION=2048
AVATAR_ALLOWED_MIME=image/jpeg,image/png,image/webp
PRESIGNED_POST_TTL_SECONDS=300
