{
  "name": "web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/web"
      }
    },
    "build": {
      "cache": false,
      "options": {
        "command": "next build",
        "cwd": "apps/web",
        "env": {
          "NODE_ENV": "production"
        }
      }
    }
  }
}
